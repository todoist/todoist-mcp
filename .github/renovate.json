{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommitTypeAll(chore)",
        "github>todoist/renovate-config:frontend-base"
    ],
    "schedule": ["before 4am on Monday"],
    "timezone": "UTC",
    "prHourlyLimit": 0,
    "labels": ["dependencies"],
    "assigneesFromCodeOwners": true,
    "reviewersFromCodeOwners": true,
    "packageRules": [
        {
            "matchPackageNames": ["@types/node"],
            "allowedVersions": "< 23"
        },
        {
            "matchPackageNames": ["oxlint", "oxfmt"],
            "groupName": "ox toolchain",
            "description": "Group oxlint and oxfmt updates into a single PR"
        },
        {
            "matchUpdateTypes": ["lockFileMaintenance"],
            "prPriority": 10,
            "description": "Open lock file maintenance first, so transitive fixes are not starved by the queue of direct updates"
        }
    ],
    "vulnerabilityAlerts": {
        "enabled": true
    },
    "osvVulnerabilityAlerts": true,
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": ["before 4am on Monday"]
    }
}
